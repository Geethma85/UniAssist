# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

GEMINI_API_KEY=your_gemini_api_key_here
FLASK_ENV=development
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Absolute path, or relative to backend/.
# Blank/unset defaults to serviceAccountKey.json.
# Choose chroma for local storage or azure for Azure AI Search.
VECTOR_STORE_BACKEND=chroma
AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-admin-key
AZURE_SEARCH_INDEX=uniassist-documents

# Cloud alternative to FIREBASE_SERVICE_ACCOUNT_PATH.
# Set through the hosting provider's secret settings.
FIREBASE_SERVICE_ACCOUNT_JSON=